<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="Innowise" constructor="KanbanBoard" version="0.7.12" display-name-key="KanbanBoard" description-key="KanbanBoard description" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from CDS -->
    <property name="tasksJson"
          display-name-key="Tasks JSON"
          description-key="Tasks JSON"
          of-type="SingleLine.Text"
          usage="bound"
          required="false" />

    <property name="updatedTaskId"
          display-name-key="Updated Task Id"
          description-key="ID of the task that was just updated"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="newStatus"
          display-name-key="New Status"
          description-key="New Status"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="addTaskRequested"
          display-name-key="Add Task Requested"
          description-key="AddTaskRequested"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="addTaskStatus"
          display-name-key="Add Task Status"
          description-key="AddTaskStatus"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="updatedTasksJson"
          display-name-key="Updated Tasks JSON"
          description-key="Updated Tasks JSON"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="bucketsJson"
          display-name-key="Buckets JSON"
          description-key="Buckets JSON"
          of-type="SingleLine.Text"
          usage="bound"
          required="false" />

    <property name="updatedBucketsJson"
          display-name-key="Updated Buckets JSON"
          description-key="Updated Buckets JSON"
          of-type="SingleLine.Text"
          usage="output" />

    <property name="usersJson" 
              display-name-key="Users JSON"
              description-key="Users JSON"
              of-type="SingleLine.Text" 
              usage="bound" />

    <property name="openTaskId"
              display-name-key="Open Task Id"
              description-key="Task id to auto-open"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <property name="languageCode"
              display-name-key="Language Code"
              description-key="Selected app language"
              of-type="SingleLine.Text"
              usage="bound"
              required="false" />

    <property name="readOnly"
          display-name-key="Read Only"
          description-key="Whether task editing is disabled"
          of-type="SingleLine.Text"
          usage="bound"
          required="false" />

    <property name="actionTrigger"
          display-name-key="Action Trigger"
          description-key="Fires to trigger OnChange"
          of-type="SingleLine.Text"
          usage="output" />


    <!--
      Property node's of-type attribute can be of-type-group attribute.
      Example:
      <type-group name="numbers">
        <type>Whole.None</type>
        <type>Currency</type>
        <type>FP</type>
        <type>Decimal</type>
      </type-group>
      <property name="sampleProperty" display-name-key="Property_Display_Key" description-key="Property_Desc_Key" of-type-group="numbers" usage="bound" required="true" />
    -->
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/KanbanBoard.css" order="1" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <css path="css/KanbanBoard.css" order="1" />
      <resx path="strings/KanbanBoard.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
